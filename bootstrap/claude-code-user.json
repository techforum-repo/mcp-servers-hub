{
  "mcpServers": {
    "github-external-tool": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${ENV:GITHUB_TOKEN}"
      }
    },
    "sample-internal-tool": {
      "command": "node",
      "args": ["__MCP_SERVER_ENTRYPOINT__"]
    }
  }
}
