{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "sample-internal-tool": {
      "command": "node",
      "args": ["__SERVERS_DIR__/sample-internal-tool/dist/index.js"]
    }
  }
}
